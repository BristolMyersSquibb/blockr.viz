{
  "name": "blockr.viz",
  "private": true,
  "description": "Test harness for the chart JavaScript in inst/js (see tests/js/).",
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/js/*.test.js tests/js/chart/*.test.js tests/js/core/*.test.js",
    "test:core": "node --test tests/js/core/*.test.js",
    "lint": "eslint inst/js/core inst/js/spec",
    "typecheck": "tsc -p tsconfig.core.json"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "happy-dom": "^20.11.2",
    "typescript": "5.9.3"
  }
}
