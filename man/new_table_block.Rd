\strong{\code{type = "pair"}}
\itemize{
\item \code{name}: Column header. Default \code{NULL}: auto ("Rows", "Mean AGE").
\item \code{facet}: Repeats the column once per level, on one scale. At most 15 levels, 300 for tiles. Default \code{NULL}: no facet.
\item \code{x}: Start value, drawn as a hollow diamond. Required.
\item \code{xend}: End value, drawn as a dot. Required.
\item \code{x_func}: How \code{x} is read per group. One of \code{"identity"}, \code{"mean"}, \code{"median"}, \code{"min"}, \code{"max"}. Default: \code{"identity"}.
\item \code{xend_func}: How \code{xend} is read per group. One of \code{"identity"}, \code{"mean"}, \code{"median"}, \code{"min"}, \code{"max"}. Default: \code{"max"}.
\item \code{ref_min}: A number or a column: the low end of a shaded reference range. An \code{xend} outside the range is drawn open. Default \code{NULL}: no range.
\item \code{ref_max}: A number or a column: the high end of the range. Default \code{NULL}: no range.
\item \code{x_lines}: Dashed guide lines, as the chart's \code{x_lines}. Default \code{NULL}: no line.
\item \code{linetype}: Non-first levels of this column are drawn dashed. Default \code{NULL}: all solid.
\item \code{color}: Color split, at most 15 levels. Default \code{NULL}: no color split.
}

\strong{\code{type = "expr"}}
\itemize{
\item \code{name}: Column header. Default \code{NULL}: auto ("Rows", "Mean AGE").
\item \code{facet}: Repeats the column once per level, on one scale. At most 15 levels, 300 for tiles. Default \code{NULL}: no facet.
\item \code{expr}: R expression evaluated in dplyr::summarise() per row group. A numeric result is a number cell, anything else text. Required.
}

\strong{\code{type = "custom"}}
\itemize{
\item \code{name}: Column header. Default \code{NULL}: auto ("Rows", "Mean AGE").
\item \code{facet}: Repeats the column once per level, on one scale. At most 15 levels, 300 for tiles. Default \code{NULL}: no facet.
\item \code{show}: The mark; NULL reads it off the result's columns. One of \code{"bar"}, \code{"number"}, \code{"dumbbell"}, \code{"box"}, \code{"pointrange"}, \code{"text"}. Default \code{NULL}: read off the result.
\item \code{fn}: A function of \code{d}, the rows grouped by table row. Returns a data frame or named vector with columns among value, from, to, lo, q1, mid, q3, hi, text, plus at most one color column. Required.
\item \code{id}: A count prints "n (pct\%)" with N the distinct values of this column. Default \code{NULL}: count rows.
}
}

\section{Shadings}{

Each entry of \code{shadings} is a list with these keys.
\itemize{
\item \code{mode}: "diverging" centers on 0, "sequential" ramps two colors, "bar" draws a data bar in the cell. An unknown mode is an error. One of \code{"diverging"}, \code{"sequential"}, \code{"bar"}. Default: \code{"diverging"}.
\item \code{columns}: Numeric columns the rule paints. Default \code{NULL}: every numeric column no earlier rule claims.
\item \code{domain}: \code{c(low, high)} the colors span, e.g. \code{c(-1, 1)} for correlations. Default \code{NULL}: the data range; diverging is symmetric around 0.
}
}

\examples{
# Records: the input's rows, two columns, filtering on a click
new_table_block(columns = c("Species", "Sepal.Length"), drill = "auto")

# Groups: per species a row count, a mean and a box of petal lengths
new_table_block(
  layout = "groups", by = "Species",
  summaries = list(
    list(type = "simple", func = "count"),
    list(type = "simple", func = "mean", col = "Sepal.Length"),
    list(type = "dist", col = "Petal.Length")
  )
)

# The same as cards
new_table_block(
  layout = "groups", look = "cards",
  summaries = list(list(type = "simple", func = "count"))
)

# Variables: a Table 1, one column per species
new_table_block(layout = "variables", by = "Species")

if (interactive()) {
  blockr.core::serve(
    new_table_block(layout = "groups", by = "Species",
                    summaries = list(list(type = "simple", func = "count")),
                    drill = "auto"),
    data = list(data = iris)
  )
}
}
