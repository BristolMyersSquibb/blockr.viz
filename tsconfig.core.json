{
  // Type-checks the rewritten JS: inst/js/core and the generated specs.
  // Strict and checkJs on every file; no per-file opt-in.
  // Run: npm run typecheck
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["inst/js/core/**/*.js", "inst/js/core/**/*.d.ts",
              "inst/js/spec/**/*.js", "inst/js/spec/**/*.d.ts"]
}
